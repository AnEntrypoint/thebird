{
  "name": "thebird",
  "version": "0.2.0",
  "description": "A Node CLI and library whose operations dispatch through gm tooling",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cli": "./src/cli.js"
  },
  "bin": {
    "thebird": "./bin/thebird.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check bin/thebird.js && node --check src/*.js",
    "start": "node bin/thebird.js",
    "witness": "node scripts/witness.mjs"
  },
  "repository": "https://github.com/AnEntrypoint/thebird.git"
}
