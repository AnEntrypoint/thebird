{
  "version": 1,
  "scope": "user-wide",
  "audience": "agents",
  "title": "Set up a thebird webserver",
  "summary": "Use normal Node, npm and bash. Register a webserver; the system gives you a folder and live routes.",
  "commands": [
    "node bin/thebird-webserver.js register my-app --title 'My App'",
    "cd .thebird/webservers/my-app",
    "npm install",
    "npm start",
    "node ../../bin/thebird-webserver.js list"
  ],
  "routes": [
    "/sites/my-app/",
    "/sites/my-app/favicon.ico",
    "/sites/my-app/settings",
    "/sites/my-app/mcp"
  ],
  "sdk": [
    "thebird/sdk/node",
    "thebird/sdk/browser"
  ],
  "live": [
    "/__thebird/registry",
    "/__thebird/events",
    "/__thebird/progress",
    "/__thebird/mcp/my-app"
  ],
  "craft": {
    "title": "Lazy craft document apps",
    "commands": [
      "node bin/thebird-craft.js ensure gridcraft|wordcraft|pdfcraft",
      "node bin/thebird-craft.js sample",
      "node bin/thebird-craft.js status",
      "node bin/thebird-craft.js processes",
      "node bin/thebird-craft.js intent \"review sheet.xlsx\"",
      "node bin/thebird-craft.js open .thebird/webservers/gridcraft/documents/sample.csv",
      "node bin/thebird-craft.js descriptor pdfcraft"
    ],
    "intent": {
      "sheet/xlsx/csv": "gridcraft",
      "doc/docx/odt/rtf": "wordcraft",
      "pdf": "pdfcraft"
    },
    "mcp": [
      "/ __thebird/craft",
      "/ __thebird/craft/intent",
      "/ __thebird/mcp/gridcraft",
      "/ __thebird/mcp/wordcraft",
      "/ __thebird/mcp/pdfcraft"
    ],
    "display": "Open/task calls create a visible THEBIRD_FEATURES document card and send SSE/HMR progress."
  },
  "fxCapabilities": {
    "environment": "normal computer",
    "toolAvailability": "bash and ask are wired live in-session through the shell client; terminal tools are available",
    "commands": [
      "bash",
      "sh",
      "node",
      "npm",
      "npx",
      "tjs",
      "qjs",
      "curl",
      "wget",
      "git",
      "python3",
      "pip",
      "sqlite3",
      "fx",
      "feature",
      "playwriter"
    ],
    "filesystem": "/workspace and browser OPFS-backed shell workspace",
    "webservers": [
      "/__thebird/registry",
      "/__thebird/events",
      "/__thebird/progress",
      "/__thebird/mcp",
      "/sites/<id>/settings"
    ],
    "craft": [
      "gridcraft",
      "wordcraft",
      "pdfcraft"
    ],
    "browserApis": [
      "fetch",
      "EventSource",
      "THEBIRD_WEBSERVERS",
      "THEBIRD_CRAFT",
      "THEBIRD_FEATURES"
    ],
    "forbiddenRefusals": [
      "terminal tools are unavailable",
      "JavaScript host",
      "crippled JS host",
      "cannot inspect files",
      "no exit code or shell output"
    ],
    "selfCheck": "Ask fx to create and run a normal Node server; the answer must describe commands or actions, not claim that terminal tools are unavailable."
  }
}
